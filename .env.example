# Copy this file to .env and adjust values:  copy .env.example .env

# --- Ollama (LLM) ---
# On Windows use 127.0.0.1 instead of localhost (localhost can add ~2s IPv6 fallback delay)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
MAX_HISTORY=6

# --- Whisper (STT) ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Piper (TTS) ---
PIPER_VOICE=en_US-lessac-medium

# --- VAD (voice activity detection) ---
VAD_SILENCE_SECONDS=1.0
VAD_MAX_SECONDS=15
VAD_START_TIMEOUT=8
VAD_MULTIPLIER=3.0
# Machine/mic specific. 0.004 worked for the author's mic (it outputs exact zeros when silent).
VAD_MIN_THRESHOLD=0.004

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000